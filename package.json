{
  "name": "office-club-discord-bot-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2",
      "mysql2": "3.24.4"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "discord:register": "tsx src/register-commands.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:database": "vitest run tests/integration/rewards-database.test.ts tests/integration/tenman-schema.test.ts tests/integration/tenman-invariants.test.ts",
    "test:contract": "vitest run tests/contracts --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/formbody": "9.0.0",
    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "discord.js": "14.27.0",
    "fastify": "5.12.5",
    "pg": "8.16.3",
    "pino": "9.9.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "22.18.1",
    "@types/pg": "8.15.5",
    "dotenv": "17.4.2",
    "eslint": "9.35.0",
    "prettier": "3.6.2",
    "prisma": "7.10.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "4.1.11"
  }
}
