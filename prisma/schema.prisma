generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MatchState {
  CREATED
  READY_CHECK
  TEAM_SELECTION
  MAP_VETO
  TEAMS_LOCKED
  SERVER_PROVISIONING
  SERVER_BOOTING
  SERVER_READY
  MATCH_LOADED
  WARMUP
  LIVE
  PAUSED
  FINISHED
  CANCELED
  FAILED
}

enum TenManQueueStatus {
  OPEN
  LOCKED
  DISABLED
}

enum MatchDiscordResourceType {
  MATCH_TEXT_CHANNEL
  MATCH_DASHBOARD_MESSAGE
  MATCH_RESULT_RECEIPT
}

enum DemoArtifactStatus {
  EXPECTED
  SOURCE_READY
  TRANSFERRING
  STORED
  UNAVAILABLE
  EXPIRED
  FAILED
}

enum MatchDiscordResourceState {
  PENDING_CREATE
  CREATE_IN_FLIGHT
  ACTIVE
  PENDING_DELETE
  DELETED
  ARCHIVED
}

enum CaptainPolicy {
  RANDOM
  VOLUNTEER
  HIGHEST_RATING
  ADMIN_SELECTED
}

enum TeamSelectionMode {
  RANDOM
  CAPTAINS
  BALANCED
  ADMIN_ASSIGNED
}

enum MapSelectionMode {
  CAPTAIN_VETO
  RANDOM
  ADMIN_SELECTED
  PRESELECTED
}

enum DraftTeam {
  TEAM_1
  TEAM_2
}

enum VetoAction {
  BAN
  PICK
  DECIDER
}

enum MatchResultStatus {
  PENDING
  APPLIED
  REVERSED
}

enum CleanupStatus {
  NOT_REQUIRED
  PENDING
  RUNNING
  RETRY
  COMPLETE
  FAILED
}

enum PlayerTeam {
  UNASSIGNED
  TEAM_1
  TEAM_2
  SPECTATOR
}

enum ParticipantRole {
  PLAYER
  SPECTATOR
}

enum ReadyState {
  NOT_READY
  READY
  WAITING_FOR_VOICE
}

enum JobStatus {
  PENDING
  RUNNING
  RETRY
  COMPLETE
  FAILED
}

enum ProvisioningStatus {
  DUPLICATE_REQUEST_PENDING
  DUPLICATE_OUTCOME_UNKNOWN
  SERVER_IDENTIFIED
  AMBIGUOUS
  COMPLETE
  FAILED
}

enum CredentialCapability {
  CONFIG_READ
  EVENT_WRITE
}

enum ManagedResourceState {
  NONE
  SETTING_UP
  ACTIVE
  TEARING_DOWN
}

enum ManagedSetupStep {
  RESERVED
  CATEGORY_CREATE_IN_FLIGHT
  CATEGORY_CREATED
  LOBBY_TEXT_CREATE_IN_FLIGHT
  LOBBY_TEXT_CREATED
  LOBBY_VOICE_CREATE_IN_FLIGHT
  LOBBY_VOICE_CREATED
  TEAM1_VOICE_CREATE_IN_FLIGHT
  TEAM1_VOICE_CREATED
  TEAM2_VOICE_CREATE_IN_FLIGHT
  TEAM2_VOICE_CREATED
}

enum RewardSource {
  TEXT_ACTIVITY
  VOICE_ACTIVITY
  ADMIN_ADJUSTMENT
}

enum RewardVoiceSessionStatus {
  ACTIVE
  CLOSED
}

model User {
  discordUserId   String          @id @map("discord_user_id")
  displayName     String          @map("display_name")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  steamIdentities SteamIdentity[]
  matchPlayers    MatchPlayer[]
  queueEntries    TenManQueueEntry[]
  partyMemberships TenManPartyMember[]
  partyInvitations TenManPartyInvite[]
  playerStats     PlayerGuildStats[]
  rewardMembers   RewardMember[]
  assignmentDisputes SteamAssignmentDispute[]

  @@map("users")
}

model SteamIdentity {
  id                 String    @id @default(uuid()) @db.Uuid
  discordUserId      String    @map("discord_user_id")
  steamId64          String    @map("steam_id_64")
  assignedAt         DateTime  @default(now()) @map("assigned_at")
  assignmentSource   String    @default("MODAL_SELF_ASSIGN") @map("assignment_source")
  invalidatedAt      DateTime? @map("invalidated_at")
  invalidationReason String?   @map("invalidation_reason")
  provenance         String    @default("SELF_ASSIGNMENT")
  createdAt          DateTime  @default(now()) @map("created_at")
  user               User      @relation(fields: [discordUserId], references: [discordUserId])

  @@index([discordUserId])
  @@index([steamId64])
  @@map("steam_identities")
}

model SteamAssignmentDispute {
  id                 String    @id @default(uuid()) @db.Uuid
  guildId            String    @map("guild_id")
  discordUserId      String    @map("discord_user_id")
  steamId64          String    @map("steam_id_64")
  status             String    @default("PENDING") @map("status")
  actorDiscordUserId String?   @map("actor_discord_user_id")
  resolution         String?   @map("resolution")
  createdAt          DateTime  @default(now()) @map("created_at")
  resolvedAt         DateTime? @map("resolved_at")
  user               User      @relation(fields: [discordUserId], references: [discordUserId])

  @@index([guildId, status])
  @@index([discordUserId, steamId64])
  @@map("steam_assignment_disputes")
}

model MatchResultDispute {
  id                 String    @id @default(uuid()) @db.Uuid
  matchId            String    @map("match_id") @db.Uuid
  discordUserId      String    @map("discord_user_id")
  reason             String
  status             String    @default("PENDING") @map("status")
  actorDiscordUserId String?   @map("actor_discord_user_id")
  resolution         String?   @map("resolution")
  createdAt          DateTime  @default(now()) @map("created_at")
  resolvedAt         DateTime? @map("resolved_at")
  match              Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([status])
  @@map("match_result_disputes")
}

model WebSession {
  id            String   @id @default(uuid()) @db.Uuid
  tokenHash     String   @unique @map("token_hash")
  discordUserId String   @map("discord_user_id")
  expiresAt     DateTime @map("expires_at")
  lastSeenAt    DateTime @default(now()) @map("last_seen_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("web_sessions")
}

model GuildSettings {
  guildId                   String               @id @map("guild_id")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  tenManSettings            TenManSettings?
  rewardSettings            RewardSettings?
  rewardMembers             RewardMember[]
  rewardLevels              RewardLevel[]
  rewardLedgerEntries       RewardLedgerEntry[]
  rewardActivityReceipts    RewardActivityReceipt[]
  rewardVoiceSessions       RewardVoiceSession[]

  @@map("suite_guilds")
}

model TenManSettings {
  guildId                 String   @id @map("guild_id")
  lobbyTextChannelId      String?  @map("lobby_text_channel_id")
  lobbyVoiceChannelId     String?  @map("lobby_voice_channel_id")
  team1VoiceChannelId     String?  @map("team1_voice_channel_id")
    team2VoiceChannelId     String?  @map("team2_voice_channel_id")
    resultsChannelId        String?  @map("results_channel_id")
  privilegedRoleIds       String[] @map("privileged_role_ids")
  moderatorRoleIds        String[] @map("moderator_role_ids")
  administratorRoleIds    String[] @map("administrator_role_ids")
  dathostTemplateServerId String?  @map("dathost_template_server_id")
  defaultServerLocation   String?  @map("default_server_location")
  defaultGameProfileKey      String?              @map("default_game_profile_key")
  enabled                    Boolean              @default(false)
  queueSize                  Int                  @default(10) @map("queue_size")
  partyEnabled               Boolean              @default(false) @map("party_enabled")
  readyTimeoutSeconds        Int                  @default(90) @map("ready_timeout_seconds")
  captainPolicy              CaptainPolicy        @default(RANDOM) @map("captain_policy")
  teamSelectionMode          TeamSelectionMode    @default(CAPTAINS) @map("team_selection_mode")
  mapSelectionMode           MapSelectionMode     @default(CAPTAIN_VETO) @map("map_selection_mode")
  managedResourceState       ManagedResourceState @default(NONE) @map("managed_resource_state")
  managedSetupStep           ManagedSetupStep?    @map("managed_setup_step")
  managedAttemptId           String?               @map("managed_attempt_id") @db.Uuid
  managedCategoryId          String?               @map("managed_category_id")
  managedChannelIds          String[]              @default([]) @map("managed_channel_ids")
  managedResourcesCreatedAt  DateTime?             @map("managed_resources_created_at")
  version                     Int                  @default(0)
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  matches                  Match[]
  queue                    TenManQueue?
  queueBans                TenManQueueBan[]
  parties                  TenManParty[]
  playerStats              PlayerGuildStats[]
  suite                    GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@map("guild_settings")
}

model RewardSettings {
  guildId                   String        @id @map("guild_id")
  enabled                   Boolean       @default(false)
  textXpAmount              Int           @default(10) @map("text_xp_amount")
  textCooldownSeconds       Int           @default(60) @map("text_cooldown_seconds")
  voiceXpAmount             Int           @default(5) @map("voice_xp_amount")
  voiceIntervalSeconds      Int           @default(300) @map("voice_interval_seconds")
  textChannelIds            String[]      @default([]) @map("text_channel_ids")
  voiceChannelIds           String[]      @default([]) @map("voice_channel_ids")
  tagRequiredSeconds        Int           @default(2592000) @map("tag_required_seconds")
  tagRewardRoleId           String?       @map("tag_reward_role_id")
  tagReconcileSeconds       Int           @default(900) @map("tag_reconcile_seconds")
  version                   Int           @default(0)
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @updatedAt @map("updated_at")
  guild                     GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@map("reward_settings")
}

model RewardMember {
  guildId             String              @map("guild_id")
  discordUserId       String              @map("discord_user_id")
  effectiveXp         Int                 @default(0) @map("effective_xp")
  currentLevel        Int                 @default(0) @map("current_level")
  lastTextAwardAt     DateTime?           @map("last_text_award_at")
  tagQualifiedSince   DateTime?           @map("tag_qualified_since")
  tagLastCheckedAt    DateTime?           @map("tag_last_checked_at")
  tagRoleGranted      Boolean             @default(false) @map("tag_role_granted")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  guild               GuildSettings       @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  user                User                @relation(fields: [discordUserId], references: [discordUserId])
  ledgerEntries       RewardLedgerEntry[]
  voiceSessions       RewardVoiceSession[]

  @@id([guildId, discordUserId])
  @@index([guildId, effectiveXp])
  @@map("reward_members")
}

model RewardLevel {
  guildId       String        @map("guild_id")
  level         Int
  xpThreshold   Int           @map("xp_threshold")
  label         String?
  roleId        String?       @map("role_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  guild         GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@id([guildId, level])
  @@unique([guildId, xpThreshold])
  @@map("reward_levels")
}

model RewardLedgerEntry {
  id                   String        @id @default(uuid()) @db.Uuid
  guildId              String        @map("guild_id")
  discordUserId        String        @map("discord_user_id")
  amount               Int
  source               RewardSource
  idempotencyKey       String        @map("idempotency_key")
  actorDiscordUserId   String?       @map("actor_discord_user_id")
  reason               String?
  metadata             Json
  createdAt            DateTime      @default(now()) @map("created_at")
  guild                GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  member               RewardMember @relation(fields: [guildId, discordUserId], references: [guildId, discordUserId], onDelete: Cascade)

  @@unique([guildId, idempotencyKey])
  @@index([guildId, discordUserId, createdAt])
  @@map("reward_ledger_entries")
}

model RewardActivityReceipt {
  id             String        @id @default(uuid()) @db.Uuid
  guildId        String        @map("guild_id")
  discordUserId  String        @map("discord_user_id")
  idempotencyKey String        @map("idempotency_key")
  source         RewardSource
  accepted       Boolean
  createdAt      DateTime      @default(now()) @map("created_at")
  guild          GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, idempotencyKey])
  @@index([guildId, createdAt])
  @@map("reward_activity_receipts")
}

model RewardVoiceSession {
  id                   String                   @id @default(uuid()) @db.Uuid
  guildId              String                   @map("guild_id")
  discordUserId        String                   @map("discord_user_id")
  channelId            String                   @map("channel_id")
  status               RewardVoiceSessionStatus @default(ACTIVE)
  connectedAt          DateTime                 @map("connected_at")
  checkpointAt         DateTime                 @map("checkpoint_at")
  closedAt             DateTime?                @map("closed_at")
  version              Int                      @default(0)
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  guild                GuildSettings            @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  member               RewardMember             @relation(fields: [guildId, discordUserId], references: [guildId, discordUserId], onDelete: Cascade)

  @@index([guildId, status, checkpointAt])
  @@map("reward_voice_sessions")
}

model GameProfile {
  key             String   @id
  enabled         Boolean  @default(false)
  playersPerTeam  Int      @map("players_per_team")
  numMaps         Int      @default(1) @map("num_maps")
  serverSlots     Int      @map("server_slots")
  mapAllowlist    String[] @map("map_allowlist")
  matchzyOptions  Json     @map("matchzy_options")
  allowedCvars    Json     @map("allowed_cvars")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  matches          Match[]

  @@map("game_profiles")
}

model Match {
  id                       String                @id @default(uuid()) @db.Uuid
  guildId                  String                @map("guild_id")
  leaderDiscordUserId      String                @map("leader_discord_user_id")
  state                    MatchState            @default(CREATED)
  phaseDeadlineAt          DateTime?             @map("phase_deadline_at")
  phaseGeneration          Int                   @default(0) @map("phase_generation")
  cleanupStatus            CleanupStatus         @default(NOT_REQUIRED) @map("cleanup_status")
  guildSlotActive          Boolean               @default(true) @map("guild_slot_active")
  selectedMap              String?               @map("selected_map")
  selectedGameProfileKey   String                @map("selected_game_profile_key")
  dathostServerId          String?               @unique @map("dathost_server_id")
  dathostIp                String?               @map("dathost_ip")
  dathostPort              Int?                  @map("dathost_port")
  encryptedRconPassword    String?               @map("encrypted_rcon_password")
  encryptedJoinPassword    String?               @map("encrypted_join_password")
  matchzyMatchId           Int                   @unique @default(autoincrement()) @map("matchzy_match_id")
  matchzyConfig            Json?                 @map("matchzy_config")
  matchzyConfigHash        String?               @map("matchzy_config_hash")
  lastMatchzyEventAt       DateTime?             @map("last_matchzy_event_at")
  result                   Json?
  resultStatus             MatchResultStatus     @default(PENDING) @map("result_status")
  score                    Json?
  failureReason            String?               @map("failure_reason")
  version                  Int                   @default(0)
  createdAt                DateTime              @default(now()) @map("created_at")
  startedAt                DateTime?             @map("started_at")
  finishedAt               DateTime?             @map("finished_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")
  guild                    TenManSettings        @relation(fields: [guildId], references: [guildId])
  profile                  GameProfile           @relation(fields: [selectedGameProfileKey], references: [key])
  players                  MatchPlayer[]
  transitions              MatchStateTransition[]
  cleanupTransitions       CleanupTransition[]
  auditEvents              AuditEvent[]
  externalEvents           ExternalEvent[]
  reconciliationEvents     ReconciliationEvent[]
  provisioningAttempts     ProvisioningAttempt[]
  jobs                     Job[]
  demoReferences           DemoReference[]
  credentials              MatchCredential[]
  discordResources         MatchDiscordResource[]
  draftPicks               MatchDraftPick[]
  vetoActions              MatchVetoAction[]
  ratingChanges            MatchRatingChange[]
  resultDisputes           MatchResultDispute[]

  @@index([guildId, state])
  @@index([state, lastMatchzyEventAt])
  @@map("matches")
}

model MatchPlayer {
  id                  String          @id @default(uuid()) @db.Uuid
  matchId             String          @map("match_id") @db.Uuid
  discordUserId       String          @map("discord_user_id")
  steamId64           String          @map("steam_id_64")
  displayNameSnapshot String          @map("display_name_snapshot")
  partyId             String?         @map("party_id") @db.Uuid
  participantRole     ParticipantRole @default(PLAYER) @map("participant_role")
  team                PlayerTeam      @default(UNASSIGNED)
  readyState          ReadyState      @default(NOT_READY) @map("ready_state")
  captainTeam         DraftTeam?      @map("captain_team")
  draftOrder          Int?            @map("draft_order")
  joinedAt            DateTime        @default(now()) @map("joined_at")
  match               Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user                User            @relation(fields: [discordUserId], references: [discordUserId])
  party               TenManParty?    @relation(fields: [partyId], references: [id], onDelete: SetNull)

  @@unique([matchId, discordUserId])
  @@unique([matchId, steamId64])
  @@index([matchId, team])
  @@map("match_players")
}

model TenManQueue {
  guildId             String            @id @map("guild_id")
  status              TenManQueueStatus @default(OPEN)
  version             Int               @default(0)
  panelChannelId      String?           @map("panel_channel_id")
  panelMessageId      String?           @map("panel_message_id")
  lastQueueAlertCount Int               @default(0) @map("last_queue_alert_count")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  guild               TenManSettings    @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  entries             TenManQueueEntry[]

  @@map("tenman_queues")
}

model TenManQueueEntry {
  id                  String      @id @default(uuid()) @db.Uuid
  guildId             String      @map("guild_id")
  discordUserId       String      @map("discord_user_id")
  steamId64           String      @map("steam_id_64")
  displayNameSnapshot String      @map("display_name_snapshot")
  partyId             String?     @map("party_id") @db.Uuid
  joinedAt            DateTime    @default(now()) @map("joined_at")
  queue               TenManQueue @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  user                User        @relation(fields: [discordUserId], references: [discordUserId])
  party               TenManParty? @relation(fields: [partyId], references: [id], onDelete: SetNull)

  @@unique([guildId, discordUserId])
  @@unique([guildId, steamId64])
  @@index([guildId, joinedAt])
  @@map("tenman_queue_entries")
}

model TenManParty {
  id        String               @id @default(uuid()) @db.Uuid
  guildId   String               @map("guild_id")
  leaderDiscordUserId String     @map("leader_discord_user_id")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  guild     TenManSettings       @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  members   TenManPartyMember[]
  invitations TenManPartyInvite[]
  queueEntries TenManQueueEntry[]
  matchPlayers MatchPlayer[]

  @@index([guildId])
  @@map("tenman_parties")
}

model TenManPartyMember {
  partyId       String     @map("party_id") @db.Uuid
  discordUserId String     @map("discord_user_id")
  joinedAt      DateTime   @default(now()) @map("joined_at")
  party         TenManParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [discordUserId], references: [discordUserId])

  @@id([partyId, discordUserId])
  @@unique([discordUserId])
  @@map("tenman_party_members")
}

/// A durable, recipient-bound invitation.  An invitation is never authority on
/// its own: acceptance re-checks party capacity, party enablement, queue state,
/// and the recipient's single-party membership invariant in the same transaction.
model TenManPartyInvite {
  id                    String       @id @default(uuid()) @db.Uuid
  partyId               String       @map("party_id") @db.Uuid
  inviteeDiscordUserId  String       @map("invitee_discord_user_id")
  inviterDiscordUserId  String       @map("inviter_discord_user_id")
  expiresAt             DateTime     @map("expires_at")
  acceptedAt            DateTime?    @map("accepted_at")
  revokedAt             DateTime?    @map("revoked_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  party                 TenManParty  @relation(fields: [partyId], references: [id], onDelete: Cascade)
  invitee               User         @relation(fields: [inviteeDiscordUserId], references: [discordUserId])

  @@index([partyId, inviteeDiscordUserId, expiresAt])
  @@index([inviteeDiscordUserId, expiresAt])
  @@map("tenman_party_invites")
}

model TenManQueueBan {
  id                  String         @id @default(uuid()) @db.Uuid
  guildId             String         @map("guild_id")
  discordUserId       String         @map("discord_user_id")
  reason              String
  actorDiscordUserId  String         @map("actor_discord_user_id")
  expiresAt           DateTime?      @map("expires_at")
  revokedAt           DateTime?      @map("revoked_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  guild               TenManSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, discordUserId, expiresAt])
  @@map("tenman_queue_bans")
}

model TenManNotificationPreference {
  guildId       String   @map("guild_id")
  discordUserId String   @map("discord_user_id")
  queueAlert    Boolean  @default(false) @map("queue_alert")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@id([guildId, discordUserId])
  @@index([guildId, queueAlert])
  @@map("tenman_notification_preferences")
}

model MatchDiscordResource {
  id           String                    @id @default(uuid()) @db.Uuid
  matchId      String                    @map("match_id") @db.Uuid
  resourceType MatchDiscordResourceType  @map("resource_type")
  discordId    String?                   @map("discord_id")
  createdByBot Boolean                   @default(false) @map("created_by_bot")
  state        MatchDiscordResourceState @default(PENDING_CREATE)
  /// Durable identity for one creation attempt. It is cleared only before Discord
  /// creation has begun, so stale pre-I/O leases can be reclaimed safely.
  creationAttemptId       String?   @map("creation_attempt_id")
  creationLeaseExpiresAt  DateTime? @map("creation_lease_expires_at")
  creationIoStartedAt     DateTime? @map("creation_io_started_at")
  createdAt    DateTime                  @default(now()) @map("created_at")
  deletedAt    DateTime?                 @map("deleted_at")
  match        Match                     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, resourceType])
  @@index([matchId, state])
  @@map("match_discord_resources")
}

model MatchDraftPick {
  id                    String    @id @default(uuid()) @db.Uuid
  matchId               String    @map("match_id") @db.Uuid
  pickNumber            Int       @map("pick_number")
  captainDiscordUserId  String    @map("captain_discord_user_id")
  selectedDiscordUserId String    @map("selected_discord_user_id")
  team                  DraftTeam
  createdAt             DateTime  @default(now()) @map("created_at")
  match                 Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, pickNumber])
  @@unique([matchId, selectedDiscordUserId])
  @@map("match_draft_picks")
}

model MatchVetoAction {
  id        String     @id @default(uuid()) @db.Uuid
  matchId   String     @map("match_id") @db.Uuid
  sequence  Int
  actorTeam DraftTeam  @map("actor_team")
  action    VetoAction
  mapName   String     @map("map_name")
  createdAt DateTime   @default(now()) @map("created_at")
  match     Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, sequence])
  @@unique([matchId, mapName])
  @@map("match_veto_actions")
}

model PlayerGuildStats {
  guildId       String         @map("guild_id")
  discordUserId String         @map("discord_user_id")
  rating        Int            @default(1000)
  wins          Int            @default(0)
  losses        Int            @default(0)
  matchesPlayed Int            @default(0) @map("matches_played")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  guild         TenManSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  user          User           @relation(fields: [discordUserId], references: [discordUserId])

  @@id([guildId, discordUserId])
  @@index([guildId, rating])
  @@map("player_guild_stats")
}

model MatchRatingChange {
  id            String   @id @default(uuid()) @db.Uuid
  matchId       String   @map("match_id") @db.Uuid
  discordUserId String   @map("discord_user_id")
  ratingBefore  Int      @map("rating_before")
  delta         Int
  ratingAfter   Int      @map("rating_after")
  reversedAt    DateTime? @map("reversed_at")
  createdAt     DateTime @default(now()) @map("created_at")
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, discordUserId])
  @@map("match_rating_changes")
}

model MatchStateTransition {
  id        String     @id @default(uuid()) @db.Uuid
  matchId   String     @map("match_id") @db.Uuid
  fromState MatchState @map("from_state")
  toState   MatchState @map("to_state")
  source    String
  reason    String?
  eventId   String?    @map("event_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  match     Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@map("match_state_transitions")
}

model CleanupTransition {
  id         String        @id @default(uuid()) @db.Uuid
  matchId    String        @map("match_id") @db.Uuid
  fromStatus CleanupStatus @map("from_status")
  toStatus   CleanupStatus @map("to_status")
  reason     String?
  createdAt  DateTime      @default(now()) @map("created_at")
  match      Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@map("cleanup_transitions")
}

model AuditEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  matchId              String?  @map("match_id") @db.Uuid
  guildId              String   @map("guild_id")
  actorDiscordUserId   String?  @map("actor_discord_user_id")
  eventType            String   @map("event_type")
  result               String
  correlationId        String   @map("correlation_id")
  metadata             Json
  createdAt            DateTime @default(now()) @map("created_at")
  match                Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([guildId, createdAt])
  @@index([matchId, createdAt])
  @@map("audit_events")
}

model ExternalEvent {
  id             String    @id @default(uuid()) @db.Uuid
  matchId        String    @map("match_id") @db.Uuid
  provider       String
  eventType      String    @map("event_type")
  dedupeKey      String    @map("dedupe_key")
  payload        Json
  payloadHash    String    @map("payload_hash")
  processedAt    DateTime? @map("processed_at")
  processingError String?  @map("processing_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  match          Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, provider, dedupeKey])
  @@index([matchId, createdAt])
  @@map("external_events")
}

model ReconciliationEvent {
  id          String   @id @default(uuid()) @db.Uuid
  matchId     String   @map("match_id") @db.Uuid
  observation Json
  correction  Json?
  result      String
  createdAt   DateTime @default(now()) @map("created_at")
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@map("reconciliation_events")
}

model ProvisioningAttempt {
  id                   String             @id @default(uuid()) @db.Uuid
  matchId              String             @map("match_id") @db.Uuid
  status               ProvisioningStatus
  provisionalName      String             @unique @map("provisional_name")
  requestedTemplateId  String             @map("requested_template_id")
  requestedLocation    String             @map("requested_location")
  requestStartedAt     DateTime?          @map("request_started_at")
  requestFinishedAt    DateTime?          @map("request_finished_at")
  dathostServerId      String?            @map("dathost_server_id")
  candidateEvidence    Json?              @map("candidate_evidence")
  operatorResolution   Json?              @map("operator_resolution")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  match                Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, status])
  @@map("provisioning_attempts")
}

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  matchId     String?   @map("match_id") @db.Uuid
  type        String
  status      JobStatus @default(PENDING)
  idempotencyKey String @unique @map("idempotency_key")
  payload     Json
  attempts    Int       @default(0)
  runAt       DateTime  @default(now()) @map("run_at")
  leaseOwner  String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  match       Match?    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@map("jobs")
}

model MatchCredential {
  id         String               @id @default(uuid()) @db.Uuid
  matchId    String               @map("match_id") @db.Uuid
  capability CredentialCapability
  tokenHash  String               @unique @map("token_hash")
  serverId   String?              @map("server_id")
  version    Int                  @default(1)
  expiresAt  DateTime             @map("expires_at")
  revokedAt  DateTime?            @map("revoked_at")
  createdAt  DateTime             @default(now()) @map("created_at")
  match      Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, capability, version])
  @@index([matchId, capability, expiresAt])
  @@map("match_credentials")
}

model DemoReference {
    id                   String             @id @default(uuid()) @db.Uuid
    matchId              String             @map("match_id") @db.Uuid
    mapNumber            Int                @map("map_number")
    mapName              String             @map("map_name")
    status               DemoArtifactStatus @default(EXPECTED)
    sourceFilename       String?            @map("source_filename")
    storageKey           String?            @map("storage_key")
    byteCount            BigInt?            @map("byte_count")
    sha256               String?
    observedAt           DateTime?          @map("observed_at")
    collectionDeadlineAt DateTime           @map("collection_deadline_at")
    storedAt             DateTime?          @map("stored_at")
    expiredAt            DateTime?          @map("expired_at")
    failureReason        String?            @map("failure_reason")
    retryCount           Int                @default(0) @map("retry_count")
    createdAt            DateTime           @default(now()) @map("created_at")
    updatedAt            DateTime           @updatedAt @map("updated_at")
    match                Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)

    @@unique([matchId, mapNumber])
    @@index([status, collectionDeadlineAt])
  @@map("demo_references")
}
